# Copy to runtime.env and fill through a secure credential workflow.
# Never commit runtime.env.
DATABASE_URL=postgresql://runtime_user:REDACTED@provider-host:5432/database?sslmode=require
AUTH_JWT_ISSUER=https://YOUR_AUTH_DOMAIN/
AUTH_JWT_AUDIENCE=YOUR_API_AUDIENCE
AUTH_JWKS_URI=https://YOUR_AUTH_DOMAIN/.well-known/jwks.json
